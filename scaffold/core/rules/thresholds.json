{
  "_meta": {
    "rules_version": "2026.11.1",
    "note": "阈值随代码走，不进 app-config。改了这里必须同时升 _meta.rules_version，否则历史报告不可复现（详见 core/config.py 注释）。"
  },
  "l2": {
    "arp": {
      "min_requests": 2
    }
  },
  "l3": {

# ---------------- 便携运行环境（体积过大，不纳入版本库）----------------
# tools/  ≈ 360 MB：便携 Python 3.11 + Wireshark Portable + Npcap 安装包
# harness/ ≈ 540 MB：DeepSeek Harness 便携版（可选 Agent 底座）
tools/
harness/

# ---------------- 用户配置（可能含 API Key，绝不入库）----------------
# 首次运行会自动生成 mcp-wireshark.json / harness-config.json（盘符自适应）
# app-config.json / ai-config.json 可复制同名 .example.json 得到
config/app-config.json
config/ai-config.json
config/mcp-wireshark.json
config/harness-config.json

# ---------------- 运行产物 ----------------
# 注意：目录要写成 dir/* 而不是 dir/，否则无法用 ! 重新包含示例文件
captures/*
reports/*
logs/*
__pycache__/
*.py[cod]
*.pcap
*.pcapng
*.ai.md
*.log

# ---------------- 保留的示例文件 ----------------
!captures/faults_demo.pcap
!reports/faults_demo.md
!reports/faults_demo.json

# ---------------- 系统 / 编辑器 ----------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.tmp
*.bak
System Volume Information/
$RECYCLE.BIN/
